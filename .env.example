# Identifiant de l'instance : https://pro.dendreo.com/<DENDREO_SLUG>/api/
DENDREO_SLUG=
# Clé API Dendreo (Paramètres > API dans Dendreo)
DENDREO_API_KEY=
# Jeton secret protégeant l'URL du connecteur : https://<app>.vercel.app/api/mcp?token=<MCP_AUTH_TOKEN>
MCP_AUTH_TOKEN=
# Optionnel, pour les tests : remplace https://pro.dendreo.com/<slug>/api/
# DENDREO_BASE_URL=
# Optionnel : 0 désactive la ligne de journal « mcp_outil » (taille des réponses par outil)
# MCP_MESURE=
